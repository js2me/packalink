{
  "compilerOptions": {
    "types": ["node"],
    "target": "ESNext",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "typeRoots": [
      "./node_modules/@types/", "./types", "./node_modules"
    ],
    "noEmit": false,
    "paths": {
      "packalink": ["./src/index.ts"],
      "packalink/define-config": ["./src/define-config.ts"],
      "packalink/run": ["./src/run/index.ts"],
      "packalink/utils": ["./src/utils/index.ts"],
      "packalink/bin": ["./src/bin.ts"]
    }
  },
  "include": [
    "src"
  ]
}
